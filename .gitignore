# ==========================================
# Pink Papaya Website - Git Ignore Rules
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Production Outputs
/.next/
/out/
/build
/dist
/.vercel

# TypeScript & Caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo

# Environment Files (Do NOT commit sensitive credentials)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Local Media & Uploads (Dev fallback; production uses external MEDIA_DIR)
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/dummy*.svg

# Testing & Coverage
/coverage

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Miscellaneous / Temporary
*.pem

