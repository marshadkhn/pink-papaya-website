// NOTE: This repo currently uses MongoDB (Mongoose) in runtime.
// This Prisma schema is provided as a future-ready, relational representation
// of the CMS module (as requested) if/when you migrate CMS storage to PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CmsRoleKey {
  super_admin
  admin
  editor
  content_manager
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  roleKey      CmsRoleKey @default(admin)
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

model Role {
  key            CmsRoleKey @id
  name           String
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  key         String           @id
  label       String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       CmsRoleKey
  permissionKey String

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

model Page {
  id         String      @id @default(uuid())
  slug       String      @unique
  label      String
  publicPath String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  sections   PageSection[]
  contents   PageContent[]
  seo        PageSeo?

  @@map("pages")
}

model PageSection {
  id        String   @id @default(uuid())
  pageId    String
  key       String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page   Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
  @@map("page_sections")
}

model PageContent {
  id          String   @id @default(uuid())
  pageId      String
  sectionKey  String
  fieldKey    String
  value       Json
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey, fieldKey])
  @@map("page_content")
}

model PageSeo {
  pageId      String   @id
  title       String?
  description String?
  keywords    String[]
  ogImageUrl  String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_seo")
}

model MediaLibrary {
  id          String   @id @default(uuid())
  key         String   @unique
  url         String
  fileName    String
  contentType String
  size        Int
  alt         String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media_library")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
