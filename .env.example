# Core
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-strong-32-char-secret

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pink-papaya

# Media storage (client uploads — property/blog images)
# Absolute path on disk where uploaded media is stored and pre-optimized to WebP.
# In production, set this to /srv/papaya-media (served statically by Nginx at /media/,
# outside the cloned repo so it survives redeploys). Leave unset for local dev to use
# ./public/uploads.
MEDIA_DIR=

# Optional static asset CDN (Cloudflare / CloudFront) for /public assets
NEXT_PUBLIC_CDN_BASE_URL=
