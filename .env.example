# Core
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-strong-32-char-secret

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pink-papaya

# AWS S3
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name
# Optional: CloudFront URL or custom S3 public URL
AWS_S3_PUBLIC_BASE_URL=https://your-cloudfront-domain.com

# Optional static asset CDN (Cloudflare / CloudFront)
NEXT_PUBLIC_CDN_BASE_URL=

